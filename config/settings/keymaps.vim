"""""""""""""
"  KEYMAPS  "
"""""""""""""

let mapleader = " "

""" BUFFERS """
" Switch to next/previous buffer
nnoremap <leader>bn :bn<CR>
nnoremap <leader>bp :bp<CR>

" Open new buffer
nnoremap <leader>be :e 

" Close buffer
nnoremap <leader>bc :bw

" Open fuzzy finder
nnoremap <leader>F :Files<CR>

