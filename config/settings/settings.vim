""""""""""""""
"  SETTINGS  "
""""""""""""""

set background=dark
colorscheme gruvbox

set relativenumber
set number

" Show tabs and file status + open file name on top
set showtabline=2
set laststatus=2

set encoding=utf-8

" Some servers have issues with backup files, see #649
set nobackup
set nowritebackup

set tabstop=4
set softtabstop=4
set shiftwidth=4
set autoindent
set smartindent

set termguicolors

set colorcolumn=100
